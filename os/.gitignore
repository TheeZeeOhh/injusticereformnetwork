# live-build working + output artifacts
.build/
cache/
chroot/
chroot.files
binary/
binary.modified_timestamp
*.iso
*.img
*.log

# Staged app package (build it locally; don't commit the binary)
config/packages.chroot/*.deb

# Real secrets — never commit an actual VPN config (keys). Ship only .example.
config/includes.chroot/etc/wireguard/irn.conf

# Claude Code sandbox artifacts (auto-created, zero-byte, read-only)
.claude/
.mcp.json
.cc-writes/

# Python bytecode — never overlay this into the image
__pycache__/
*.pyc

# Staged app sources. Copied in from ten other repos at build time by
# stage-apps.sh (manifest-driven) and stage-extras.sh (Zee Zee, Ollama).
# 741M at last count, none of it ours to version: committing it would fork
# every one of those projects into this history. Rebuild it, don't track it.
config/includes.chroot/opt/irn-apps/
config/includes.chroot/opt/zee-zee/
config/includes.chroot/opt/ollama/
