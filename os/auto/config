#!/bin/sh
# IRN OS live-build configuration.
# `auto/config` makes the build reproducible: `lb config` reads this instead of
# taking ad-hoc flags, so every build starts from the same declared state.
set -e

# Kernel hardening parameters come from the file that installed systems also read
# (via /etc/default/grub.d/99-irn-harden.cfg), so live and installed boots cannot
# drift. lb runs this script from the build root, which is where the path resolves.
IRN_KERNEL_CMDLINE_FILE="config/includes.chroot/etc/irn/kernel-cmdline"
[ -f "$IRN_KERNEL_CMDLINE_FILE" ] || { echo "E: $IRN_KERNEL_CMDLINE_FILE missing" >&2; exit 1; }
IRN_KERNEL_CMDLINE="$(grep -v '^[[:space:]]*#' "$IRN_KERNEL_CMDLINE_FILE" | tr '\n' ' ' | tr -s ' ' | sed 's/^ //; s/ $//')"
[ -n "$IRN_KERNEL_CMDLINE" ] || { echo "E: $IRN_KERNEL_CMDLINE_FILE has no parameters" >&2; exit 1; }

lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--archive-areas "main contrib non-free non-free-firmware" \
	--binary-images iso-hybrid \
	--bootloaders "syslinux,grub-efi" \
	--bootappend-live "boot=live components quiet splash noeject hostname=irn-os username=irn mce=off $IRN_KERNEL_CMDLINE" \
	--bootappend-install "$IRN_KERNEL_CMDLINE" \
	--debian-installer live \
	--iso-application "IRN OS" \
	--iso-volume "IRN-OS" \
	--memtest none \
	--apt-recommends false \
	"${@}"
