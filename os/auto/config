#!/bin/sh
# IRN OS live-build configuration.
# `auto/config` makes the build reproducible: `lb config` reads this instead of
# taking ad-hoc flags, so every build starts from the same declared state.
set -e

lb config noauto \
	--distribution bookworm \
	--architectures amd64 \
	--archive-areas "main contrib non-free non-free-firmware" \
	--binary-images iso-hybrid \
	--bootloaders "syslinux,grub-efi" \
	--bootappend-live "boot=live components quiet splash noeject hostname=irn-os username=irn init_on_alloc=1 init_on_free=1 mce=off" \
	--bootappend-install "init_on_alloc=1 init_on_free=1" \
	--debian-installer live \
	--iso-application "IRN OS" \
	--iso-volume "IRN-OS" \
	--memtest none \
	--apt-recommends false \
	"${@}"
