// Waybar — bottom dock (IRN command center, ported from the kiosk box)
{
  "layer": "top",
  "position": "bottom",
  "height": 57,
  "margin-bottom": 6,
  "spacing": 8,

  "modules-left": [],
  "modules-center": ["custom/launcher", "wlr/taskbar"],
  "modules-right": [],

  "custom/launcher": {
    "format": "󰀻",
    "tooltip": false,
    "on-click": "fuzzel"
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 36,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["waybar"]
  }
}
