<?xml version="1.0"?>
<!-- Hardened desktop root menu (right-click). Full menu — this is a usable
     desktop, not a sealed kiosk. -->
<openbox_menu>

<menu id="root-menu">
  <item label="Applications…"><action name="Execute" command="fuzzel" /></item>
  <item label="Sanctuary (IRN)"><action name="Execute" command="sanctuary" /></item>
  <item label="IRN Browser"><action name="Execute" command="irn-browser" /></item>
  <item label="Files"><action name="Execute" command="thunar" /></item>
  <item label="Terminal"><action name="Execute" command="foot" /></item>
  <item label="Sanctuary Terminal"><action name="Execute" command="sanctuary-terminal" /></item>
  <item label="Zee Zee (AI twin)"><action name="Execute" command="zee-zee" /></item>
  <item label="IRN Store"><action name="Execute" command="irn-store" /></item>
  <item label="Screenshot region"><action name="Execute" command="sh -c 'grim -g &quot;$(slurp)&quot; - | wl-copy'" /></item>
  <separator />
  <item label="Lock screen"><action name="Execute" command="swaylock -c 0b1a2b" /></item>
  <item label="Reconfigure"><action name="Reconfigure" /></item>
  <item label="Exit"><action name="Exit" /></item>
</menu>

</openbox_menu>
