# labwc autostart — IRN OS hardened desktop (command center).
# Ported from the Garuda box, adapted for the image: Sanctuary via the launcher
# wrapper, the desktop shell (bars + dock + idle lock), and the system EQ.

# Background: the IRN crest, centred on black. labwc reads no gsettings, so the
# Cinnamon gschema override does not reach it -- swaybg has to be told directly.
# -m center keeps the near-square crest uncropped; -c fills the surround to match.
swaybg -i /usr/share/backgrounds/irn/irn-logo.jpg -m center -c '#000000' >/dev/null 2>&1 &

# Top bar (workspaces, clock, audio, network, battery, tray).
waybar >/dev/null 2>&1 &

# Bottom dock (waybar, second instance styled as a dock, with the fuzzel launcher).
waybar -c ~/.config/waybar/dock.jsonc -s ~/.config/waybar/dock.css >/dev/null 2>&1 &

# Idle: lock after inactivity.
swayidle -w \
  timeout 600 'swaylock -f -c 0b1a2b' \
  before-sleep 'swaylock -f -c 0b1a2b' >/dev/null 2>&1 &

# System-wide audio EQ (EasyEffects on PipeWire): headless + apply the IRN preset.
easyeffects --gapplication-service >/dev/null 2>&1 &
( sleep 2; easyeffects -l IRN ) >/dev/null 2>&1 &

# Launch Sanctuary maximized. NOTE: output captured to /tmp for the CSP gauntlet;
# revert to >/dev/null once confirmed clean.
( sleep 1; sanctuary ) >/tmp/sanctuary-runtime.log 2>&1 &
