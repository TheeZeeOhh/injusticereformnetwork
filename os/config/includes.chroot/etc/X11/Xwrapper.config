# Xorg.wrap policy — read by xserver-xorg-legacy's setuid wrapper.
#
# WHY THIS FILE EXISTS: the Cinnamon session starts X with `startx` from
# irn-kiosk, running as the UNPRIVILEGED session user. Debian's /usr/bin/Xorg is
# not setuid; without xserver-xorg-legacy + this policy, that startx dies with
# "Only console users are allowed to run the X server" and greetd relaunches
# irn-kiosk in a tight loop — a black screen with no explanation.
#
# allowed_users=console
#   Only a user logged in on a virtual console may start X. greetd runs the
#   session on vt1 with a real logind session (libpam-systemd + etc/pam.d/greetd),
#   and logind chowns the VT to that user, so the check passes. This is the
#   tighter of the two useful settings.
#
#   If a build ever lands where X refuses to start with "console users only"
#   despite a healthy session, the diagnostic loosening is `anybody` — but that
#   lets ANY local user spawn an X server, so treat it as a last resort and a bug
#   to fix, not a default.
#
# needs_root_rights=auto
#   Prefer a rootless X server: with a logind session the server gets its DRM
#   master and input devices from logind and never needs real root. `auto` falls
#   back to the setuid path only where rootless genuinely cannot work. Forcing
#   `yes` would hand full root to the X server on every boot for no gain.
#
# UNVERIFIED: chosen from the documented semantics, not yet confirmed on a booted
# image. If the Cinnamon session does not come up, this file is the first suspect.
allowed_users=console
needs_root_rights=auto
