{
  "_comment": "IRN OS — hardened Brave. Chromium/Brave enterprise policy, applied to every profile and not user-overridable. Unknown keys are ignored by Brave, so this file is safe to trim. See os/BROWSER.md for the rationale and how to relax any of these.",

  "_privacy_no_egress": "Nothing phones home.",
  "MetricsReportingEnabled": false,
  "UrlKeyedAnonymizedDataCollectionEnabled": false,
  "SafeBrowsingProtectionLevel": 0,
  "SafeBrowsingExtendedReportingEnabled": false,
  "SearchSuggestEnabled": false,
  "SpellCheckServiceEnabled": false,
  "TranslateEnabled": false,
  "NetworkPredictionOptions": 2,
  "AutofillAddressEnabled": false,
  "AutofillCreditCardEnabled": false,
  "PasswordManagerEnabled": false,
  "PaymentMethodQueryEnabled": false,

  "_transport": "Encrypt the pipe and hide DNS.",
  "HttpsOnlyMode": "force_enabled",
  "DnsOverHttpsMode": "secure",
  "DnsOverHttpsTemplates": "https://dns.quad9.net/dns-query",

  "_no_persistence": "Amnesiac-friendly: keep little on disk.",
  "SavingBrowserHistoryDisabled": true,
  "DownloadRestrictions": 3,

  "_lockdown": "Close the attack surface and the account funnels.",
  "SyncDisabled": true,
  "BrowserSignin": 0,
  "BrowserGuestModeEnabled": false,
  "BackgroundModeEnabled": false,
  "EnableMediaRouter": false,
  "DefaultBrowserSettingEnabled": false,
  "PromotionalTabsEnabled": false,
  "ShoppingListEnabled": false,
  "ExtensionInstallBlocklist": ["*"],
  "BlockExternalExtensions": true,

  "_search": "Private default search, no keystroke leakage.",
  "DefaultSearchProviderEnabled": true,
  "DefaultSearchProviderName": "DuckDuckGo",
  "DefaultSearchProviderSearchURL": "https://duckduckgo.com/?q={searchTerms}",

  "_startup": "Blank start, no promo/onboarding pages.",
  "HomepageLocation": "about:blank",
  "NewTabPageLocation": "about:blank",
  "RestoreOnStartup": 5,

  "_brave_specific": "Turn off Brave's crypto/ad/VPN/AI surfaces and Tor egress.",
  "BraveRewardsDisabled": true,
  "BraveWalletDisabled": true,
  "BraveVPNDisabled": true,
  "BraveAIChatEnabled": false,
  "TorDisabled": true
}
