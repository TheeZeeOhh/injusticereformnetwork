    "DisableFeedbackCommands": true,
    "DisablePocket": true,
    "DisableFirefoxAccounts": true,
    "DisableFormHistory": true,
    "DisableDefaultBrowserAgent": true,
    "DisableSetDesktopBackground": true,
    "DisableProfileImport": true,
    "DisableAppUpdate": true,
    "PasswordManagerEnabled": false,
    "OfferToSaveLogins": false,
    "SearchSuggestEnabled": false,
    "NetworkPrediction": false,
    "PromptForDownloadLocation": true,
    "DisableDeveloperTools": false,
    "TranslateEnabled": true,
    "HttpsOnlyMode": "force_enabled",
    "HttpAllowlist": [],
    "DNSOverHTTPS": {
      "Enabled": true,
      "ProviderURL": "https://dns.quad9.net/dns-query",
      "Fallback": false,
      "Locked": true
    },
    "Certificates": {
      "ImportEnterpriseRoots": false
    },
    "EncryptedMediaExtensions": {
      "Enabled": false,
      "Locked": false
    },
    "PDFjs": {
      "Enabled": true,
      "EnablePermissions": false
    },
    "EnableTrackingProtection": {
      "Value": true,
      "Locked": true,
      "Cryptomining": true,
      "Fingerprinting": true,
      "EmailTracking": true
    },
    "Cookies": {
      "Behavior": "reject-tracker-and-partition-foreign",
      "BehaviorPrivateBrowsing": "reject-tracker-and-partition-foreign",
      "Locked": false
    },
    "ExtensionUpdate": true,
    "InstallAddonsPermission": {
      "Default": true
    },
    "ExtensionSettings": {
      "*": {
        "installation_mode": "allowed"
      },
      "paste-guard@irn.local": {
        "installation_mode": "force_installed",
        "install_url": "file:///usr/local/lib/irn-browser/paste-guard.xpi"
      },
      "uBlock0@raymondhill.net": {
        "installation_mode": "force_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi"
      },
      "addon@darkreader.org": {
        "installation_mode": "force_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/darkreader/latest.xpi"
      },
      "@testpilot-containers": {
        "installation_mode": "normal_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/multi-account-containers/latest.xpi"
      },
      "{74145f27-f039-47ce-a470-a662b129930a}": {
        "installation_mode": "normal_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/clearurls/latest.xpi"
      },
      "{531906d3-e22f-4a6c-a102-8057b88a1a63}": {
        "installation_mode": "normal_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/single-file/latest.xpi"
      }
    },
    "FirefoxHome": {
      "Search": true,
      "TopSites": true,
      "SponsoredTopSites": false,
      "Highlights": false,
      "Pocket": false,
      "SponsoredPocket": false,
      "Snippets": false,
      "Locked": false
    },
    "UserMessaging": {
      "WhatsNew": false,
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "UrlbarInterventions": false,
      "SkipOnboarding": true,
      "MoreFromMozilla": false,
      "Locked": false
    },
    "FirefoxSuggest": {
      "WebSuggestions": false,
      "SponsoredSuggestions": false,
      "ImproveSuggest": false,
      "Locked": true
    },
    "SearchEngines": {
      "Default": "DuckDuckGo",
      "PreventInstalls": false,
      "Add": [
        {
          "Name": "CourtListener",
          "Alias": "cl",
          "Description": "Free case law, dockets and oral argument (Free Law Project)",
          "Method": "GET",
          "URLTemplate": "https://www.courtlistener.com/?q={searchTerms}"
        },
        {
          "Name": "RECAP Dockets",
          "Alias": "recap",
          "Description": "Federal dockets mirrored from PACER — search before you pay",
          "Method": "GET",
          "URLTemplate": "https://www.courtlistener.com/?type=r&q={searchTerms}"
        },
        {
          "Name": "Cornell LII",
          "Alias": "lii",
          "Description": "US Code, CFR and Supreme Court opinions",
          "Method": "GET",
          "URLTemplate": "https://www.law.cornell.edu/search/site/{searchTerms}"
        },
        {
          "Name": "Google Scholar — case law",
          "Alias": "scholar",
          "Description": "Case law search, opinions only",
          "Method": "GET",
          "URLTemplate": "https://scholar.google.com/scholar?as_sdt=2006&q={searchTerms}"
        },
        {
          "Name": "MuckRock",
          "Alias": "foia",
          "Description": "Filed FOIA requests and released documents",
          "Method": "GET",
          "URLTemplate": "https://www.muckrock.com/search/?q={searchTerms}"
        },
        {
          "Name": "Virginia Courts CIS",
          "Alias": "va",
          "Description": "Virginia general district / circuit court case information",
          "Method": "GET",
          "URLTemplate": "https://eapps.courts.state.va.us/gdcourts/searchLanding.do?q={searchTerms}"
        },
        {
          "Name": "Federal Register",
          "Alias": "fedreg",
          "Description": "Rules, proposed rules and notices — comment deadlines",
          "Method": "GET",
          "URLTemplate": "https://www.federalregister.gov/documents/search?conditions%5Bterm%5D={searchTerms}"
        },
        {
          "Name": "Wayback Machine",
          "Alias": "wb",
          "Description": "Archived copies of a URL — the page as it was",
          "Method": "GET",
          "URLTemplate": "https://web.archive.org/web/*/{searchTerms}"
        },
        {
          "Name": "Movement Advancement Project",
          "Alias": "map",
          "Description": "State-by-state LGBTQ+ policy tallies",
          "Method": "GET",
          "URLTemplate": "https://www.lgbtmap.org/search?q={searchTerms}"
        }
      ]
    },
