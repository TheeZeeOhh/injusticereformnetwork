         text-overflow:ellipsis;white-space:nowrap;max-width:45%}
  #log{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:12px}
  .msg{max-width:100%}
  .who{font-size:10px;letter-spacing:1.5px;color:var(--dim);margin-bottom:3px}
  .body{white-space:pre-wrap;word-wrap:break-word;overflow-wrap:anywhere}
  .you .body{background:var(--panel);border:1px solid var(--line);
             border-radius:8px;padding:8px 10px}
  .err .body{color:var(--amber)}
  .empty{color:var(--dim);font-size:12px;line-height:1.7;padding:4px}
  .empty code{background:var(--panel);border:1px solid var(--line);
              border-radius:3px;padding:1px 4px;font-size:11px}
  form{flex:none;border-top:1px solid var(--line);padding:8px;display:flex;gap:6px}
  textarea{flex:1;resize:none;background:#0a121c;color:var(--text);font:inherit;
           border:1px solid var(--line);border-radius:8px;padding:8px;outline:none;
           max-height:140px}
  textarea:focus{border-color:var(--accent)}
  button{background:var(--panel);color:var(--accent);border:1px solid var(--line);
         border-radius:8px;padding:0 12px;cursor:pointer;font:inherit}
  button:hover:not(:disabled){border-color:var(--accent)}
  button:disabled{opacity:.5;cursor:default}
  footer{flex:none;padding:6px 12px;border-top:1px solid var(--line);
         font-size:10px;color:var(--dim)}
</style></head>
<body>
  <header>
    <span class="dot" id="dot"></span><h1>ZEE ZEE</h1>
    <span class="model" id="model">connecting…</span>
  </header>
  <div id="log">
    <div class="empty" id="empty">
      On-device only &mdash; this runs on local Ollama and nothing leaves the box.<br><br>
      Select text on a page and use the AI shortcut, or right-click &rarr; Ask Zee Zee,
      and it arrives here.<br><br>
      <strong style="color:#ffcc66">No PHI.</strong> Client records belong in Sanctuary,
      not in a prompt.
    </div>
  </div>
  <form id="f">
    <textarea id="q" rows="1" placeholder="Ask Zee Zee…  (Enter to send)"></textarea>
    <button id="send" type="submit">&#9654;</button>
  </form>
  <footer>local model &middot; not legal advice &middot; verify every citation</footer>
<script>
(function(){
  "use strict";
  var log=document.getElementById("log"), form=document.getElementById("f"),
      q=document.getElementById("q"), send=document.getElementById("send"),
      empty=document.getElementById("empty"), dot=document.getElementById("dot"),
      modelEl=document.getElementById("model");
  var history=[], busy=false;

  function add(who,cls){
    if(empty){empty.remove();empty=null;}
    var w=document.createElement("div"); w.className="msg "+cls;
    var h=document.createElement("div"); h.className="who"; h.textContent=who;
    var b=document.createElement("div"); b.className="body";
    w.appendChild(h); w.appendChild(b); log.appendChild(w);
    log.scrollTop=log.scrollHeight; return b;
  }
  function grow(){ q.style.height="auto"; q.style.height=Math.min(q.scrollHeight,140)+"px"; }
  q.addEventListener("input",grow);
  q.addEventListener("keydown",function(e){
    if(e.key==="Enter"&&!e.shiftKey){e.preventDefault();form.requestSubmit();}
  });

  fetch("health").then(function(r){return r.json();}).then(function(d){
    dot.className="dot"+(d.available?" on":"");
    modelEl.textContent=d.available?(d.model||""):"offline — ollama serve";
  }).catch(function(){ modelEl.textContent="offline"; });

  function ask(text){
    if(busy||!text.trim())return;
    busy=true; send.disabled=true;
    add("YOU","you").textContent=text;
    var out=add("ZEE ZEE","zee");
    history.push({role:"user",content:text});
    fetch("chat",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({prompt:text,history:history.slice(-8)})
    }).then(function(r){
      if(!r.ok) throw new Error("HTTP "+r.status);
      var dec=new TextDecoder(), rd=r.body.getReader(), acc="";
      return (function pump(){
        return rd.read().then(function(res){
          if(res.done){history.push({role:"assistant",content:acc});return;}
          acc+=dec.decode(res.value,{stream:true});
          out.textContent=acc; log.scrollTop=log.scrollHeight;
          return pump();
        });
      })();
    }).catch(function(e){
      out.parentNode.className="msg err"; out.textContent="["+e.message+"]";
    }).then(function(){ busy=false; send.disabled=false; q.focus(); });
  }

  form.addEventListener("submit",function(e){
    e.preventDefault(); var t=q.value; q.value=""; grow(); ask(t);
  });

  // Firefox's sidebar navigates here with ?q=<prompt> when you use the context
  // menu or the selection shortcut. Send it straight away.
  var pre=new URLSearchParams(location.search).get("q");
  if(pre){ ask(pre); } else { q.focus(); }
})();
</script>
</body></html>
"""


class _Handler(http.server.BaseHTTPRequestHandler):
    server_version = "irn-zee"
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass  # a browser sidebar polling health should not spam the terminal

    # --- security ------------------------------------------------------------
    def _origin_ok(self):
        """Reject cross-site STATE-CHANGING requests (POST /chat).

        Deliberately not applied to GET. A top-level navigation to this page is
        legitimately cross-site: Firefox opens the sidebar with a null
        triggering principal, so the request arrives as Sec-Fetch-Site:
        cross-site. Enforcing this on GET blocks the exact thing the server
        exists for — which is how it was caught. GET serves no secrets and
        changes no state; frame-ancestors 'none' stops it being embedded."""
        allowed = {f"http://127.0.0.1:{self.server.server_address[1]}",
                   f"http://localhost:{self.server.server_address[1]}"}
        origin = self.headers.get("Origin")
        if origin and origin not in allowed:
            return False
        site = self.headers.get("Sec-Fetch-Site")
        if site and site not in ("same-origin", "none"):
            return False
        return True

    def _deny(self, code=403, msg="forbidden"):
        body = msg.encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _send(self, body, ctype="text/html; charset=utf-8", code=200):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        # The sidebar page loads nothing external; say so to the browser too.
        self.send_header("Content-Security-Policy",
                         "default-src 'none'; style-src 'unsafe-inline'; "
                         "script-src 'unsafe-inline'; connect-src 'self'; "
                         "form-action 'none'; base-uri 'none'; "
                         "frame-ancestors 'none'")
        self.send_header("X-Frame-Options", "DENY")
        self.end_headers()
        self.wfile.write(body)

    # --- routes --------------------------------------------------------------
    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if path in ("/", "/index.html"):
            return self._send(SIDEBAR_HTML)
        if path == "/health":
            models = available_models()
            model = None
            if models:
                try:
                    model = pick_model()
                except SystemExit:
                    model = models[0]
                except Exception:
                    model = models[0]
            return self._send(json.dumps({"available": bool(models), "model": model}),
                              "application/json")
        return self._deny(404, "not found")

    def do_POST(self):
        path = urllib.parse.urlparse(self.path).path
        if not self._origin_ok():
            return self._deny()
        if path != "/chat":
            return self._deny(404, "not found")
        try:
            n = int(self.headers.get("Content-Length") or 0)
            if n > 200_000:
                return self._deny(413, "too large")
            req = json.loads(self.rfile.read(n).decode("utf-8"))
        except Exception:
            return self._deny(400, "bad request")

        prompt = (req.get("prompt") or "").strip()
        if not prompt:
            return self._deny(400, "empty prompt")
        turns = ""
        for t in (req.get("history") or [])[:-1]:
            role = "User" if t.get("role") == "user" else "Zee Zee"
            turns += f"{role}: {t.get('content','')}\n"
        full = build_prompt(prompt, turns=turns)

        try:
            model = guard_model(pick_model())
        except SystemExit as e:
            return self._deny(400, str(e))
        if not model:
            return self._deny(503, f"no model available — is Ollama running at {OLLAMA}?")

        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Transfer-Encoding", "chunked")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()

        def chunk(b):
            self.wfile.write(f"{len(b):X}\r\n".encode() + b + b"\r\n")
            self.wfile.flush()

        try:
            payload = {"model": model, "prompt": full, "stream": True,
                       "keep_alive": "30m"}
            req_o = urllib.request.Request(
                OLLAMA + "/api/generate", data=json.dumps(payload).encode(),
                headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req_o, timeout=TIMEOUT) as r:
                for raw in r:
                    if not raw.strip():
                        continue
                    try:
                        d = json.loads(raw.decode("utf-8"))
                    except Exception:
                        continue
                    tok = d.get("response") or ""
                    if tok:
                        chunk(tok.encode("utf-8"))
                    if d.get("done"):
                        break
        except Exception as e:
            try:
                chunk(f"\n[error: {e}]".encode())
            except Exception:
                pass
        try:
            self.wfile.write(b"0\r\n\r\n")
            self.wfile.flush()
        except Exception:
            pass


class _Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def cmd_serve(args):
    if args.stop:
        try:
            with open(PID_FILE) as f:
                pid = int(f.read().strip())
        except OSError:
            print("irn-zee: no sidebar server recorded as running")
            return 1
        try:
            os.kill(pid, 15)
            print(f"irn-zee: stopped sidebar server (pid {pid})")
        except OSError as e:
            print(f"irn-zee: could not stop pid {pid}: {e}")
            return 1
        try:
            os.unlink(PID_FILE)
        except OSError:
            pass
        return 0

    port = args.port or DEFAULT_PORT
    get_token()  # ensure it exists for future use
    try:
        srv = _Server(("127.0.0.1", port), _Handler)
    except OSError as e:
        print(f"irn-zee: cannot bind 127.0.0.1:{port} — {e}")
        print("  Already running? Check with: irn-zee serve --stop")
        return 1

    try:
        with open(PID_FILE, "w") as f:
            f.write(str(os.getpid()))
    except OSError:
        pass

    url = f"http://127.0.0.1:{port}/"
    if args.quiet:
        # Detach: the wrapper starts us from a browser launch and must not block.
        if os.fork() > 0:
            return 0
        os.setsid()
        try:
            with open(PID_FILE, "w") as f:
                f.write(str(os.getpid()))
        except OSError:
            pass
        devnull = os.open(os.devnull, os.O_RDWR)
        os.dup2(devnull, 0); os.dup2(devnull, 1); os.dup2(devnull, 2)
    else:
        print(f"Zee Zee sidebar serving on {url}")
        print("  Point Firefox at it with:  browser.ml.chat.provider = " + url)
        print("  (the IRN mozilla.cfg already does; open the sidebar with Ctrl+Alt+X)")
        print("  Stop with: irn-zee serve --stop")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        try:
            os.unlink(PID_FILE)
        except OSError:
            pass
    return 0


def main():
    ap = argparse.ArgumentParser(
        prog="irn-zee", description="IRN Browser bridge to the local Zee Zee twin.")
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("status", help="is Zee Zee reachable")
    s.add_argument("--json", action="store_true"); s.set_defaults(fn=cmd_status)

    s = sub.add_parser("ask", help="ask a question")
    s.add_argument("question", nargs="*"); s.set_defaults(fn=cmd_ask)

    s = sub.add_parser("page", help="summarise a captured page.html")
    s.add_argument("file"); s.add_argument("question", nargs="*")
    s.set_defaults(fn=cmd_page)

    s = sub.add_parser("look", help="look at a captured render.png")
    s.add_argument("image"); s.add_argument("question", nargs="*")
    s.set_defaults(fn=cmd_look)

    s = sub.add_parser("brief", help="one-line status for the command center")
    s.add_argument("--json", action="store_true"); s.set_defaults(fn=cmd_brief)

    s = sub.add_parser("serve", help="serve the Firefox sidebar chat UI")
    s.add_argument("--port", type=int, default=None,
                   help=f"default {DEFAULT_PORT} (or $IRN_ZEE_PORT)")
    s.add_argument("--stop", action="store_true", help="stop a running server")
    s.add_argument("--quiet", action="store_true",
                   help="detach into the background (used by the irn-browser wrapper)")
    s.set_defaults(fn=cmd_serve)

    a = ap.parse_args()
    try:
        sys.exit(a.fn(a))
    except KeyboardInterrupt:
        sys.exit(130)
    except urllib.error.HTTPError as e:
        body = ""
        try:
            body = json.loads(e.read().decode()).get("error", "")
        except Exception:
            pass
        sys.exit(f"irn-zee: Ollama refused the request ({e.code}){': ' + body if body else ''}")
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        sys.exit(f"irn-zee: cannot reach Ollama at {OLLAMA} — {e}\n"
                 f"  Start it with: ollama serve")


if __name__ == "__main__":
    main()
