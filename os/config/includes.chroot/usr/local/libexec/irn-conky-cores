#!/bin/sh
# Emits the CORE MATRIX rows for conky, two threads per line.
#
# Called via ${execpi}, which RE-PARSES conky variables in this output — that is
# the whole point: conky has no loop construct, so a config that hardcodes
# cpu1..cpu8 shows eight rows on every machine. On a 4-thread box half of them
# read 0% forever; on a 16-thread box half the CPU is invisible. This emits
# exactly as many rows as the machine actually has.
set -eu
n=$(nproc 2>/dev/null || echo 1)
i=1
while [ "$i" -le "$n" ]; do
	printf '${color1}T%s:${color} ${cpu cpu%s}%% ${cpubar cpu%s 5,55}' "$((i-1))" "$i" "$i"
	if [ $((i % 2)) -eq 0 ] || [ "$i" -eq "$n" ]; then printf '\n'; else printf '  '; fi
	i=$((i+1))
done
