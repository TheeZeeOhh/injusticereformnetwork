#!/bin/sh
# Prints the default sink volume as a bare integer 0-100 (MUTED reports 0).
# IRN OS ships wireplumber, not pulseaudio-utils, so wpctl is the primary path;
# pactl is tried only as a fallback for a host that happens to have it.
#
# Every path must print SOMETHING: conky's ${execibar} treats empty output as a
# parse error, not as zero, and the bar renders as garbage rather than as empty.
#
# NOTE on `set -e`: a bare `[ ... ] && cmd` as the last command of a function or
# of an if-body returns 1 when the test fails, which under `set -e` kills the
# script and prints nothing at all. Every conditional below is written as a full
# if/fi for that reason -- an earlier `&&` version exited 1 with no output.
set -eu

vol=""

if command -v wpctl >/dev/null 2>&1; then
	out="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)"
	case "$out" in
		*MUTED*) echo 0; exit 0 ;;
	esac
	v="$(printf '%s' "$out" | sed -n 's/^Volume:[[:space:]]*\([0-9.]*\).*/\1/p')"
	if [ -n "$v" ]; then
		vol="$(awk -v v="$v" 'BEGIN{printf "%d", v*100+0.5}')"
	fi
fi

if [ -z "$vol" ] && command -v pactl >/dev/null 2>&1; then
	vol="$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | sed -n 's/.*[^0-9]\([0-9]\{1,3\}\)%.*/\1/p' | head -1 || true)"
fi

if [ -z "$vol" ]; then vol=0; fi
printf '%s\n' "$vol"
