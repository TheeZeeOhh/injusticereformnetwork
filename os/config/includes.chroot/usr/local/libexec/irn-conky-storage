#!/bin/sh
# Emits the storage rows. /home is shown only when it is a SEPARATE mount --
# on the live image it is not, and duplicating the root figures under a second
# label reads as a bug.
set -eu
printf '${color1}Root:${color} ${fs_used /}/${fs_size /} ${alignr}${color1}Free:${color} ${fs_free /}\n'
printf '${color3}${fs_bar 5 /}\n'
if findmnt -no TARGET /home >/dev/null 2>&1; then
	printf '${color1}Home:${color} ${fs_used /home}/${fs_size /home} ${alignr}${color1}Free:${color} ${fs_free /home}\n'
	printf '${color3}${fs_bar 5 /home}\n'
fi
