#!/bin/sh
# Runs inside the live chroot at build time. Wires up the kiosk and applies
# baseline hardening. Keep this idempotent and fail loud.
set -eu

echo "P: IRN OS — enabling kiosk services and hardening"

# --- Session wiring ---
chmod 0755 /usr/local/bin/irn-kiosk /usr/local/bin/sanctuary /usr/local/bin/irn-greetd-config /usr/local/sbin/irn-vpn
chmod 0755 /etc/skel/.config/labwc/autostart   # labwc requires autostart executable

# --- Cinnamon (X11) session, the DEFAULT ---
# irn-kiosk execs the wrapper by absolute path, so a missing exec bit here is a
# black screen that greetd retries forever. Set it explicitly rather than trusting
# includes.chroot to have carried the mode across.
chmod 0755 /usr/local/libexec/irn-cinnamon-session /usr/local/bin/irn-session

# conky HUD: the panels call these helpers through ${execpi}/${execi}, and a
# helper that is not executable renders as an empty block rather than an error.
chmod 0755 /usr/local/bin/irn-conky /usr/local/libexec/irn-conky-*

# Sanctuary launch wrapper + keyring bootstrap, both exec'd by path.
chmod 0755 /usr/local/libexec/irn-sanctuary-session /usr/local/libexec/irn-keyring-init

# The greetd stack names pam_gnome_keyring EXPLICITLY rather than trusting
# common-auth/common-session, because on this image pam-auth-update does NOT
# enable the gnome-keyring profile -- verified on an installed system 2026-08-23,
# where both files had zero references to it. A stack that relies on the include
# authenticates fine and silently never unlocks a keyring, which is how the vault
# enrolment failure hid for so long. Fail the build loudly if the module is gone.
find /usr/lib /lib -name pam_gnome_keyring.so -print -quit 2>/dev/null | grep -q . \
	|| echo "W: pam_gnome_keyring.so missing — the vault keychain will not work." >&2
grep -q pam_gnome_keyring /etc/pam.d/greetd \
	|| echo "W: /etc/pam.d/greetd does not name pam_gnome_keyring explicitly." >&2

# Confirm the session can actually start, here at build time. irn-kiosk falls back
# to labwc when these are missing, so the failure is survivable but silent — and a
# silent fallback to the WRONG desktop is exactly the kind of thing that ships.
for b in /usr/bin/cinnamon-session /usr/bin/startx /usr/bin/conky; do
	[ -x "$b" ] || echo "W: $b missing — Cinnamon session will fall back to labwc." >&2
done

# Secret service: Sanctuary's get_vault_salts talks to org.freedesktop.secrets via
# libsecret. If gnome-keyring or the PAM module is missing, the daemon never starts
# and the vault unlock freezes on screen with no error -- so fail LOUDLY here, at
# build time, rather than shipping that. `optional` in /etc/pam.d/greetd means a
# missing module will not block login; it just silently means no keyring.
[ -x /usr/bin/gnome-keyring-daemon ] \
	|| echo "W: gnome-keyring-daemon missing — no secret service; vault unlock will hang." >&2
# NB: find, not a glob. An unmatched shell glob stays LITERAL, so a `[ -e ]` test
# on it both fails and prints the raw pattern — a false warning on any layout
# where the module sits under a different multiarch directory.
find /usr/lib /lib -name pam_gnome_keyring.so -print -quit 2>/dev/null | grep -q . \
	|| echo "W: pam_gnome_keyring.so not found — greetd cannot start/unlock the keyring." >&2
grep -q pam_gnome_keyring /etc/pam.d/greetd \
	|| echo "W: /etc/pam.d/greetd does not reference pam_gnome_keyring." >&2

# Installer password dictionary: no dict means Calamares cannot create the
# operator account at all ("no dictionary for the password"). The dict is built by
# cracklib-runtime's postinst, so check the ARTIFACT, not just the package.
ls /var/cache/cracklib/cracklib_dict.* >/dev/null 2>&1 \
	|| echo "W: /var/cache/cracklib/cracklib_dict.* missing — the installer will refuse to set a password." >&2

# Default wallpaper (the IRN crest). The override is inert until the schemas are
# recompiled, so this must run AFTER cinnamon-desktop-data is installed.
#
# Deliberately non-fatal: a bad override makes glib-compile-schemas fail for the
# entire system, and shipping a desktop with the wrong background is a far better
# outcome than failing the build over it. The keys were checked against the
# shipped schema, so this is belt-and-braces rather than an expected path.
if [ -f /usr/share/glib-2.0/schemas/99-irn-background.gschema.override ]; then
	if glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null; then
		echo "P: IRN OS — default wallpaper compiled into gsettings"
	else
		echo "W: glib-compile-schemas failed — the default wallpaper will not apply." >&2
	fi
fi
[ -f /usr/share/backgrounds/irn/irn-logo.jpg ] \
	|| echo "W: /usr/share/backgrounds/irn/irn-logo.jpg missing — wallpaper will be blank." >&2

# Xorg.wrap policy gates whether the unprivileged session user may start X at all.
[ -f /etc/X11/Xwrapper.config ] || echo "W: /etc/X11/Xwrapper.config missing — startx will be refused." >&2
# Admin-route backstop for INSTALLED systems. Inert on the live image and inert
# whenever anyone can already escalate; it exists only so the combination of
# `passwd -l root` below + Calamares not granting sudo cannot brick a machine.
chmod 0755 /usr/local/sbin/irn-ensure-admin
systemctl enable irn-ensure-admin.service

systemctl enable seatd.service
systemctl enable greetd.service
systemctl set-default graphical.target

# greetd runs on vt1 (etc/greetd/config.toml). live-config also points an
# autologin getty at tty1, and the two overwrite each other on the console —
# that is the boot showing "irn-os login: irn (automatic login)" on top of the
# session. Give greetd sole ownership; text consoles stay on Ctrl+Alt+F2..F6.
systemctl mask getty@tty1.service

# --- Sanctuary app ---
# live-build already installed anything from config/packages.chroot/ before this
# hook runs. Resolve any leftover unmet deps, then check for the real app binary
# (the `sanctuary` launcher resolves /usr/bin/Sanctuary, /usr/bin/app, etc.).
# Warn rather than fail: the launcher shows a visible error at runtime if the app
# is missing, which is easier to diagnose than a build that dies here.
apt-get -y --fix-broken install || true
# NB: test each path separately. `ls a b c` exits non-zero if ANY operand is
# missing, so a single `ls` of all three warned on every build even when the app
# was installed — a false alarm that made the real "app missing" case unreadable.
app_found=""
for candidate in /usr/bin/Sanctuary /usr/bin/sanctuary /usr/bin/app; do
	if [ -x "$candidate" ]; then app_found="$candidate"; break; fi
done
if [ -n "$app_found" ]; then
	echo "P: Sanctuary app binary present: $app_found"
else
	echo "W: no Sanctuary app binary found in /usr/bin. Did you stage the .deb into" >&2
	echo "W: config/packages.chroot/? The image will boot to the desktop but the app" >&2
	echo "W: launcher will report the binary missing." >&2
fi

# --- Sanctuary Terminal ---
# Staged into /opt by os/stage-extras.sh before the build. Warn (don't fail) if
# it is absent: the image is still usable, and the wrapper says so at runtime.
if [ -f /opt/sanctuary-terminal/sanctuary_term.py ]; then
	chmod 0755 /usr/local/bin/sanctuary-terminal
	# Confirm the interpreter can actually import what the app needs, here at
	# build time — a missing python3-pyte only shows up as a traceback on the
	# user's screen otherwise.
	if python3 -c "import PyQt5.QtWidgets, pyte" 2>/dev/null; then
		echo "P: Sanctuary Terminal staged, PyQt5 + pyte import OK"
	else
		echo "W: Sanctuary Terminal is staged but PyQt5/pyte do not import —" >&2
		echo "W: check python3-pyqt5 and python3-pyte in the package list." >&2
	fi
else
	echo "W: /opt/sanctuary-terminal missing — run os/stage-extras.sh before building." >&2
fi

# --- Baseline hardening ---
# No remote entry: make sure nothing is listening for the network.
systemctl mask ssh.service 2>/dev/null || true
systemctl mask avahi-daemon.service 2>/dev/null || true
systemctl mask ModemManager.service 2>/dev/null || true

# No telemetry: popularity-contest should never have been pulled in
# (--apt-recommends false), but belt-and-suspenders.
apt-get -y purge popularity-contest 2>/dev/null || true

# Lock the root account (kiosk user is unprivileged; installer sets its own).
passwd -l root || true

# Kernel hardening: no core dumps (they can leak decrypted PHI from RAM),
# restrict kernel pointer/log exposure.
cat > /etc/sysctl.d/99-irn-harden.conf <<'EOF'
kernel.kptr_restrict=2
kernel.dmesg_restrict=1
fs.suid_dumpable=0
kernel.yama.ptrace_scope=2
EOF

# Disable core dumps at the limits level too.
printf '* hard core 0\n' > /etc/security/limits.d/99-irn-nocore.conf

echo "P: IRN OS hardening complete"
