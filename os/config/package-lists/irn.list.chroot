# Packages baked into the IRN OS live filesystem.
# Kept deliberately minimal — every package is attack surface.

# --- Wayland session stack ---
labwc
seatd
greetd
xwayland
foot

# --- Session / bus plumbing labwc needs ---
dbus-user-session
libpam-systemd

# --- Hardened desktop shell (waybar + fuzzel launcher + friends) ---
waybar
fuzzel
swaybg
swayidle
swaylock
thunar
grim
slurp
wl-clipboard
brightnessctl
network-manager
# audio for the waybar pulseaudio module (wpctl comes from wireplumber)
wireplumber
pipewire-pulse
# Nerd-Font glyphs used by the bars. Debian's fonts-jetbrains-mono is NOT the
# Nerd-patched build, so the PUA icons may render as tofu — drop a Nerd Font
# into /etc/skel/.local/share/fonts to fix. See README "Fonts".
fonts-jetbrains-mono

# --- VPN: WireGuard (free, bring-your-own config) + OpenVPN import ---
wireguard-tools
openresolv
openvpn
network-manager-openvpn

# --- Hardened daily-driver browser ---
# firefox-esr is IN Debian (no third-party repo needed). Hardening is applied by
# hooks/live/0300-firefox.hook.chroot (enterprise policy + autoconfig): telemetry
# and tracking off, DoH + HTTPS-only, sponsored content off, add-ons ENABLED.
firefox-esr

# --- Sanctuary Terminal (staged from its own repo by stage-extras.sh) ---
# A PyQt5 terminal emulator over a pty. Debian ships both dependencies, so the
# image uses those rather than the project's .venv, which is built against
# another distro's Python and would not resolve here.
python3-pyqt5
python3-pyte

# --- Zee Zee (AI twin) + local Ollama brain ---
# Staged from their own trees by stage-extras.sh. Everything Debian packages is
# taken from Debian; only anthropic / SpeechRecognition / openwakeword go through
# pip into /opt/zee-zee/.venv (see hooks/live/0600-zee-zee.hook.chroot), because
# Debian ships none of the three.
python3-psutil
python3-numpy
python3-pil
python3-pydantic
python3-pypdf
python3-pyaudio
python3-cryptography
python3-venv
python3-pip
yt-dlp
# curl: the zee-zee wrapper uses it to check whether the local model is up.
curl
# Vulkan userspace so Ollama's vulkan backend can use an AMD/Intel GPU. Without
# these it silently falls back to CPU inference, which works but is slow.
libvulkan1
mesa-vulkan-drivers

# --- System-wide audio equalizer (PipeWire) ---
# Also the browser's EQ: EasyEffects sits below Firefox and equalizes ALL its
# audio (any origin, the Reading Room radio included) — an in-browser EQ can't,
# because createMediaElementSource silences cross-origin streams. The IRN preset
# ships in /etc/skel and is applied headless at login (labwc autostart).
easyeffects

# --- Sanctuary (Tauri) runtime deps ---
# The Sanctuary .deb is installed from config/packages.chroot; these libraries
# must be present up front because live-build does not resolve .deb deps itself.
libwebkit2gtk-4.1-0
libgtk-3-0
libayatana-appindicator3-1
librsvg2-common

# --- Encryption / installer ---
cryptsetup
cryptsetup-initramfs
calamares
calamares-settings-debian
# Password-strength dictionary for the installer's user page. Without these the
# installer reports "no dictionary for the password" on the account screen
# (observed 2026-08-23). The install can still be completed past it, so this is a
# broken-looking installer rather than a hard block -- but an installer that
# announces a missing dictionary while asking for the disk-encryption-adjacent
# operator password is not something to ship.
#
# The chain is another --apt-recommends false casualty:
#   calamares        Depends:    libpwquality1        (installed)
#   libpwquality1    Depends:    libcrack2            (installed)
#   libcrack2        Recommends: cracklib-runtime     <- dropped
#   cracklib-runtime Recommends: wamerican | wordlist <- dropped
# cracklib-runtime's postinst is what builds /var/cache/cracklib/cracklib_dict.*
# out of /usr/share/dict/words, which wamerican provides. libcrack2 without that
# dictionary cannot check anything, so pwquality errors out instead of scoring.
cracklib-runtime
wamerican

# --- Firmware so it actually boots on real hardware ---
firmware-linux-free
firmware-misc-nonfree
firmware-iwlwifi

# --- VM guest integration (clipboard + display resize) ---
# Host<->guest clipboard and automatic display resizing when IRN OS runs as a
# guest. Without it you cannot paste into the VM at all, which makes testing and
# any recovery work needlessly painful (learned the hard way, 2026-08-23).
#
# On the hardening question: this DOES open a host<->guest channel, but it is
# inert on bare metal -- spice-vdagent only activates when the SPICE virtio port
# exists, i.e. only under a hypervisor. And under a hypervisor the host already
# owns guest memory outright, so the clipboard adds no exposure that the threat
# model did not already concede. It buys real convenience where it applies and
# costs nothing where it does not.
#
# NOT included: qemu-guest-agent. That one lets the host execute commands inside
# the guest, which is a genuinely different proposition and is not needed here.
spice-vdagent

# --- Minimal diagnostics (no network clients, no browser) ---
pciutils
usbutils
