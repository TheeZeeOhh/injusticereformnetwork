# ─────────────────────────────────────────────────────────────────────────────
# $SOUL token deploy config — SEPOLIA TESTNET ONLY
#
#   Copy this file to `.env` (which is gitignored) and fill in real values.
#   NEVER put a mainnet key or a key controlling real funds in here.
#   This module deploys to a TEST network with free faucet ETH.
# ─────────────────────────────────────────────────────────────────────────────

# JSON-RPC endpoint for Sepolia (e.g. Alchemy / Infura / public RPC).
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/YOUR_PROJECT_ID"

# Deployer private key. TESTNET ONLY — a throwaway key funded from a faucet.
# 0x-prefixed 32-byte hex. Do NOT reuse a wallet that holds real assets.
PRIVATE_KEY="0xYOUR_TESTNET_PRIVATE_KEY"

# Optional: Etherscan API key for source verification after deploy.
ETHERSCAN_API_KEY="YOUR_ETHERSCAN_API_KEY"

# Optional: address to receive initial supply + mint rights.
# Defaults to the deployer address if unset.
# SOUL_OWNER="0x..."

# Optional: initial supply in whole tokens. Defaults to 1000000.
# SOUL_SUPPLY="1000000"
