# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tau personal overrides (not shared)
.claude/settings.local.json

# Secrets / environment — never commit
.env
.env.*
**/.env
**/.env.*

# Rust / Tauri build output (large, machine-specific)
src-tauri/target/

# Local operational DB (server dev sqlite; may hold data)
server/dev.db
server/*.db

# Tau scratch artifacts
.tau/

# live-build generated config + build outputs (os/).
# `lb config` writes config/{binary,bootstrap,chroot,common,source} and symlinks
# every stock hook under config/hooks/ to /usr/share/live/build/... — absolute
# links that DANGLE on any host without live-build installed (e.g. this Garuda
# box; they're created inside the build container). Authored hooks (0100-, 0300-,
# 0400-, 0500-) are real source and stay tracked.
os/config/binary
os/config/bootstrap
os/config/chroot
os/config/common
os/config/source
os/config/hooks/normal/
os/config/hooks/live/0010-disable-kexec-tools.hook.chroot
os/config/hooks/live/0050-disable-sysvinit-tmpfs.hook.chroot
os/binary.modified_timestamps
os/chroot.packages.*
os/live-image-*
# build mutex (os/build-in-container.sh)
os/.build.lock
# live-build's own lock file
os/.lock
# staged by os/stage-extras.sh from the Sanctuary Terminal repo (not vendored here)
os/config/includes.chroot/opt/sanctuary-terminal/
os/config/includes.chroot/opt/zee-zee/
os/config/includes.chroot/usr/share/ollama/
os/config/includes.chroot/usr/local/lib/ollama/
os/config/includes.chroot/usr/local/bin/ollama
os/staging/
# qemu boot-test evidence (screenshots/logs) — regenerate with os/boot-test.sh.
# Globbed so a run with a custom --out (e.g. boot-test-out-uefi/) is covered too.
os/boot-test-out*/
boot-test-out*/

# Sandbox stub dotfiles: 0-byte, mode 444 placeholders the agent sandbox drops in
# the repo root. Anchored with / so a real dotfile shipped inside the OS image
# (os/config/includes.chroot/etc/skel/...) is unaffected.
/.bashrc
/.bash_profile
/.zshrc
/.zprofile
/.profile
/.gitconfig
/.ripgreprc
/.mcp.json
/.gitmodules
/.vscode
.claude/agents
.claude/commands
.claude/hooks
.claude/launch.json
.claude/loop.md
.claude/output-styles
.claude/routines
.claude/workflows
